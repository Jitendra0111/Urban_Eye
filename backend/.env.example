# Copy this file to .env and adjust.

# U-Net++ weights from the Colab notebook: MyDrive/UrbanEye/checkpoints/unetpp_b4_oem8_v2/best.pth
SEG_WEIGHTS=models/unetpp_oem8_best.pth
SEG_ENCODER=efficientnet-b4

# Detector: auto | yolo | roboflow   (auto = YOLO weights if present, else Roboflow)
DETECTOR=auto
YOLO_WEIGHTS=models/yolo11_best.pt
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=detection-xdxfj/1

# Results database. Empty = SQLite file backend/data/urbaneye.db (nothing to install).
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/urbaneye  (pip install psycopg[binary])
DATABASE_URL=
# Saved results for "latest imagery" are reused for this many days (dated imagery never changes)
CACHE_LATEST_DAYS=7

# auto | cpu | cuda
DEVICE=auto
MAX_UPLOAD_MB=20

# Frontend origins allowed to call the API (Vite dev server = 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
